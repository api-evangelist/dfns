{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dfns Approvals Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dfns.io/webhooks"
          },
          "docs": "List webhooks"
        },
        {
          "info": {
            "name": "Create a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dfns.io/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a webhook"
        },
        {
          "info": {
            "name": "Get a webhook by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dfns.io/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a webhook by id"
        },
        {
          "info": {
            "name": "Update a webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.dfns.io/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a webhook"
        },
        {
          "info": {
            "name": "Delete a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.dfns.io/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a webhook"
        },
        {
          "info": {
            "name": "Ping a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dfns.io/webhooks/:webhookId/ping",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Sends a test event to the webhook to verify connectivity."
        },
        {
          "info": {
            "name": "List webhook events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dfns.io/webhooks/:webhookId/events",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List webhook events"
        }
      ]
    }
  ],
  "bundled": true
}