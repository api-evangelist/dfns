{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dfns Approvals Signatures API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Signatures",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a signature from a key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dfns.io/keys/:keyId/signatures",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Produces a raw signature using a standalone MPC key. Requires a User Action Signature."
        }
      ]
    }
  ],
  "bundled": true
}