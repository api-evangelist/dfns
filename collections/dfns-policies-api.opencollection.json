{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dfns Approvals Policies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dfns.io/v2/policies"
          },
          "docs": "List policies"
        },
        {
          "info": {
            "name": "Create a policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dfns.io/v2/policies",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a policy in the policy engine that governs an activity kind (e.g. Wallets:Sign) with a rule and an action (Block, RequestApproval, NoOp). Requires a User Action Signature."
        },
        {
          "info": {
            "name": "Get a policy by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dfns.io/v2/policies/:policyId",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a policy by id"
        },
        {
          "info": {
            "name": "Update a policy",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.dfns.io/v2/policies/:policyId",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a policy"
        },
        {
          "info": {
            "name": "Archive (delete) a policy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.dfns.io/v2/policies/:policyId",
            "params": [
              {
                "name": "policyId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Archives a policy so it no longer governs activities."
        }
      ]
    }
  ],
  "bundled": true
}